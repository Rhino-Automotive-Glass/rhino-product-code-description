# Copy to .env.local and fill in real values. Never commit the filled-in file.
#   cp .env.example .env.local
#
# The backup/restore scripts read .env.local and .env; values already exported
# in the shell (CI, cron) take precedence over both.

# --- Supabase project (client-side, safe to expose in the browser) -----------
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role (SERVER ONLY — bypasses RLS, never expose) --------
# Used by scripts/backup-tables.ts and scripts/backfill-display-name.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres connection string (used by scripts/backup-db.sh + restore-db.sh)
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Prefer the direct connection (port 5432) so the full schema is captured.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- npm registry token (only if installing from a private registry) ---------
NPM_TOKEN=
